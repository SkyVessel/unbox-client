{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unbox Client",
  "version": "0.2.1",
  "identifier": "dev.unbox.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Unbox Client",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 720,
        "backgroundColor": "#28292D"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": [
      "resources/*"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFMTc2REMxNEE5RjY0NkIKUldSclpKOUt3VzBYN2xlajdWVGFpSC9zNkU3SnVDS0xTLytJNHJmQzVjSHRaa0lSNHZDc29PUHAK",
      "endpoints": [
        "https://github.com/SkyVessel/unbox-client/releases/latest/download/latest.json"
      ]
    }
  }
}
